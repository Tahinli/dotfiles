[Unit]
Description=Check /tmp fill every 3 minutes and reclaim cargo build output
Documentation=file:%h/.claude/hooks/tmpfs-guard.sh

[Timer]
# Closes the gap the hook cannot see: /tmp filling DURING a long agent run, between
# SessionStart/SubagentStart boundaries. That is how it filled on 2026-08-01.
OnBootSec=3min
OnUnitActiveSec=3min
AccuracySec=30s
Persistent=false
Unit=tmpfs-guard.service

[Install]
WantedBy=timers.target
