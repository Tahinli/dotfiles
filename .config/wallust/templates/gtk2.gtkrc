# Generated by wallust

# Surfaces must match the GTK3/GTK4 steps; raw {{background}}/{{color1}} here
# made GTK2 windows near-black and selections a different accent than GTK3.
gtk-color-scheme = "bg_color:mix({{background}}, {{color1}}, 0.35)\nfg_color:{{foreground}}\nbase_color:mix({{background}}, {{color1}}, 0.30)\ntext_color:{{foreground}}\nselected_bg_color:mix({{color4}}, {{foreground}}, 0.3)\nselected_fg_color:{{color15}}\ntooltip_bg_color:mix({{background}}, {{color1}}, 0.45)\ntooltip_fg_color:{{foreground}}"

style "wallust-default" {
  bg[NORMAL]      = "mix({{background}}, {{color1}}, 0.35)"
  bg[PRELIGHT]    = "mix({{background}}, {{color1}}, 0.45)"
  bg[ACTIVE]      = "mix({{background}}, {{color1}}, 0.40)"
  bg[SELECTED]    = "mix({{color4}}, {{foreground}}, 0.3)"
  bg[INSENSITIVE] = "mix({{background}}, {{color1}}, 0.30)"

  fg[NORMAL]      = "{{foreground}}"
  fg[PRELIGHT]    = "{{foreground}}"
  fg[ACTIVE]      = "{{foreground}}"
  fg[SELECTED]    = "{{color15}}"
  fg[INSENSITIVE] = "{{color8}}"

  base[NORMAL]      = "mix({{background}}, {{color1}}, 0.30)"
  base[PRELIGHT]    = "mix({{background}}, {{color1}}, 0.35)"
  base[ACTIVE]      = "mix({{color4}}, {{foreground}}, 0.3)"
  base[SELECTED]    = "mix({{color4}}, {{foreground}}, 0.3)"
  base[INSENSITIVE] = "mix({{background}}, {{color1}}, 0.25)"

  text[NORMAL]      = "{{foreground}}"
  text[PRELIGHT]    = "{{foreground}}"
  text[ACTIVE]      = "{{color15}}"
  text[SELECTED]    = "{{color15}}"
  text[INSENSITIVE] = "{{color8}}"
}

style "wallust-tooltips" {
  bg[NORMAL] = "mix({{background}}, {{color1}}, 0.45)"
  fg[NORMAL] = "{{foreground}}"
}

class "GtkWidget"       style "wallust-default"
class "GtkButton"       style "wallust-default"
class "GtkCheckButton"  style "wallust-default"
class "GtkRadioButton"  style "wallust-default"
class "GtkEntry"        style "wallust-default"
class "GtkTreeView"     style "wallust-default"
class "GtkLabel"        style "wallust-default"
class "GtkMenu"         style "wallust-default"
class "GtkMenuItem"     style "wallust-default"
class "GtkMenuBar"      style "wallust-default"
class "GtkToolbar"      style "wallust-default"
class "GtkNotebook"     style "wallust-default"
widget_class "*<GtkNotebook>*"    style "wallust-default"
widget_class "*GtkNotebook.*"     style "wallust-default"
class "GtkScrolledWindow" style "wallust-default"
class "GtkFrame"        style "wallust-default"
class "GtkWindow"       style "wallust-default"
class "GtkDialog"       style "wallust-default"
class "GtkTooltip"      style "wallust-tooltips"

widget_class "*<GtkTreeView>*"    style "wallust-default"
widget_class "*<GtkButton>*"      style "wallust-default"
widget_class "*<GtkEntry>*"       style "wallust-default"
widget "gtk-tooltip*"             style "wallust-tooltips"
